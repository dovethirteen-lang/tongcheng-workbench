{
  "version": "1.3",
  "default_mode": "hybrid",
  "orchestrator": "Orchestrator / 主控 PM",
  "routing_rules": [
    {
      "when": ["pdf", "长图", "共享文档", "截图", "需求输入"],
      "route_to": ["Orchestrator / 主控 PM"],
      "outputs": ["可读需求文档", "结构化需求卡片"]
    },
    {
      "when": ["广告", "实验", "投放", "转化率", "留存", "预算", "补贴", "sql", "跑数", "分析报告"],
      "route_to": ["实验设计 Agent", "数据工程师 Agent", "商业分析师 Agent"],
      "outputs": ["实验方案", "SQL 请求", "结果分析", "预算建议", "行动项"]
    },
    {
      "when": ["微信", "活动", "券包", "运营需求", "小程序活动", "prd", "PRD", "需求卡片"],
      "route_to": ["增长/C 端活动产品 Agent"],
      "outputs": ["需求卡片", "PRD", "页面结构", "视觉需求说明", "依赖清单"]
    },
    {
      "when": ["notion", "归档", "知识库", "版本记录", "沉淀", "同步到notion"],
      "route_to": ["Notion 工作台 Agent"],
      "outputs": ["Notion 落库建议", "页面结构", "关联关系", "发布中间稿建议"]
    },
    {
      "when": ["多平台", "抖音", "百度", "豆包", "小红书", "接入", "接口文档", "泰罗"],
      "route_to": ["平台产品 Agent"],
      "outputs": ["接入方案", "接口差异", "依赖清单", "风险提示"]
    },
    {
      "when": ["今天做什么", "提醒", "deadline", "告警", "日报", "竞品", "待办", "todo", "反馈", "bug", "问题", "迭代"],
      "route_to": ["每日作战助手 Agent"],
      "outputs": ["今日计划", "异常告警", "deadline 提醒", "竞品摘要入口", "反馈记录"]
    }
  ],
  "global_rules": [
    "所有输入先结构化，不直接下结论",
    "所有输出都必须给出下一步动作",
    "先摘要，再分发，再按需调用专项 Agent",
    "尽量使用短、结构化、可复用的格式"
  ]
}
